Algoritmo "Atividadeprática 5"

// Autor(a)    : Nome do(a) aluno(a)
// Data atual  : 03/09/2026
Var
// Seção de Declarações das variáveis 
NUMERO1, NUMERO2:INTEIRO
RESULTADO:LOGICO



Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
NUMERO1 <- 14
NUMERO2 <- 4
//OPERADOR LOGICO E (AND)
ESCREVAL ("TESTANDO OPERADOR LOGICO e: ")
LEIA(NUMERO1)
LEIA(NUMERO2)

RESULTADO <- (NUMERO1 > NUMERO2) E (NUMERO1 > NUMERO2)
ESCREVAL (NUMERO1, ">", NUMERO2), "E", (NUMERO1, " >", NUMERO2, " =", RESULTADO)
ESCREVAL <-(NUMERO1 > NUMERO2 E (NUMERO1 > NUMERO2)
ESCREVAL ("AS DUAS CONDICOES VERDADEIRA")
ESCREVAL ("______________________________")

ESCREVAL ("TESTANDO OPERADOR LOGICO OU")
RESULTADO <- (NUMERO1>NUMERO2) OU (NUMERO1 > NUMERO2)
ESCREVAL (NUMERO1, ">", NUMERO2, "OU", NUMERO1, "< ", NUMERO2, "= ", RESULTADO)
ESCREVAL("UMA CONDICAO FOR VERDADEIRA")
ESCREVAL ("___________________________")

ESCREVAL ("TESTANDO OPERADOR LOGICO NAO")
RESULTADO <- NAO(NUMERO1>NUMERO2)
ESCREVAL (NUMERO1, ">", NUMERO2." =", RESULTADO)
ESCREVAL ("O QUE É VERDADEIRO SERÁ FALSO OU FALSO SERÁ VERDADEIRO")
ESCREVAL ("________________________________")




Fimalgoritmo