Algoritmo "testederaio"
PI: 3.14159
// o pi é uma constante
Var
// Seção de Declarações das variáveis 
Raio, Area: real


Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
//Raio <- 2
escreva ("Digite o raio: ")
leia (Raio)
area <- pi*raio*raio
escreva (raio) ("metros")

escreva (" A area do cirsulo eh: ", Area)

Fimalgoritmo